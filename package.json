{
  "name": "watchnext",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "node --import ./scripts/framework-privacy.mjs node_modules/next/dist/bin/next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "node --import ./scripts/framework-privacy.mjs node_modules/next/dist/bin/next start --hostname 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/run.mjs",
    "test:http-memory": "node tests/fixtures/http-memory-check.mjs",
    "verify:guide": "node tests/fixtures/local-guide-check.mjs",
    "verify:fresh-checkout": "node tests/fixtures/fresh-checkout-check.mjs",
    "test:watch": "vitest",
    "db:migrate:temp": "node scripts/db/migrate.mjs",
    "db:verify": "node scripts/db/verify.mjs",
    "db:init": "node --env-file-if-exists=.env.local scripts/db/init.mjs",
    "demo:prepare": "node --env-file-if-exists=.env.local scripts/demo/prepare.mjs",
    "db:verify:persistence": "node scripts/db/persistence-check.mjs",
    "db:snapshot": "node scripts/db/snapshot.mjs",
    "db:verify:backup": "node tests/fixtures/backup-check.mjs",
    "typecheck": "tsc --noEmit",
    "metadata:maintain": "node --env-file-if-exists=.env.local scripts/metadata-maintain.mjs",
    "test:mock": "node tests/fixtures/mock-foundation-browser-check.mjs",
    "contract:verify": "node scripts/verify-openapi.mjs",
    "prisma:check": "node scripts/prisma/check.mjs",
    "prisma:baseline:verify": "node scripts/prisma/verify-baseline.mjs"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "next": "16.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.3",
    "playwright": "1.64.1",
    "prisma": "6.19.3",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
