# Copy to untracked .env.local only if overriding the documented defaults.
# Keep this origin aligned with the local server port used for a demonstration.
# Open this exact host spelling/port; localhost and 127.0.0.1 are distinct origins.
WATCHNEXT_APP_ORIGIN=http://127.0.0.1:3000

# Enables only the isolated process-memory /v1 identity/group proof route.
# It never reads or writes the normal SQLite database.
# WATCHNEXT_HTTP_MEMORY=1

# Optional local storage override; unset uses the OS-local user-data directory.
# WATCHNEXT_DATABASE_PATH=C:/Users/your-name/AppData/Local/WatchNext/watchnext.sqlite

# Optional server-only YouTube Data API v3 key. Leave unset for manual entry.
# No keys are required for manual workflows, synthetic demo or isolated tests.
# YOUTUBE_API_KEY=

# Optional third-party Kinopoisk API Unofficial token; never a NEXT_PUBLIC setting.
# KINOPOISK_UNOFFICIAL_API_KEY=
