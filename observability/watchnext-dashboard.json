{
  "title": "WatchNext application metrics",
  "uid": "watchnext-app-metrics",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "watchnext-prometheus"
        },
        "query": {
          "query": "label_values(watchnext_group_participants_active, deployment_environment_name)",
          "refId": "environment"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "version",
        "label": "Deployed version",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "watchnext-prometheus"
        },
        "query": {
          "query": "label_values(watchnext_group_participants_active{deployment_environment_name=~\"$environment\"}, service_version)",
          "refId": "version"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Groups created",
      "description": "Successful group creations during the selected time range. Counters reset when the backend restarts.",
      "datasource": {
        "type": "prometheus",
        "uid": "watchnext-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(watchnext_groups_created_total{deployment_environment_name=~\"$environment\",service_version=~\"$version\"}[$__rate_interval]))",
          "legendFormat": "Created per interval"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Active group memberships",
      "description": "Active account memberships plus legacy profiles, not online users. One account in multiple groups is counted multiple times.",
      "datasource": {
        "type": "prometheus",
        "uid": "watchnext-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(watchnext_group_participants_active{deployment_environment_name=~\"$environment\",service_version=~\"$version\"})",
          "legendFormat": "Active memberships"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Titles and videos created",
      "description": "New titles saved during each interval; duplicate contributions and restorations are excluded.",
      "datasource": {
        "type": "prometheus",
        "uid": "watchnext-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(watchnext_titles_created_total{deployment_environment_name=~\"$environment\",service_version=~\"$version\"}[$__rate_interval]))",
          "legendFormat": "Created per interval"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Title creation failures",
      "description": "Failed manual or provider review save requests, including validation errors.",
      "datasource": {
        "type": "prometheus",
        "uid": "watchnext-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(watchnext_titles_creation_failures_total{deployment_environment_name=~\"$environment\",service_version=~\"$version\"}[$__rate_interval]))",
          "legendFormat": "Failures per interval"
        }
      ]
    }
  ]
}
