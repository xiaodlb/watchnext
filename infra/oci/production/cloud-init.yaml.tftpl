#cloud-config
package_update: true
packages:
  - ca-certificates
  - curl
  - git
  - docker.io
  - docker-compose-v2

runcmd:
  - [usermod, -aG, docker, ubuntu]
  - [mkdir, -p, /opt/watchnext]
  - [chown, ubuntu:ubuntu, /opt/watchnext]
  - [su, -, ubuntu, -c, "git clone --branch '${branch}' --single-branch '${repository}' /opt/watchnext"]
  - [sh, -c, "printf '%s' '${env_file_b64}' | base64 --decode > /opt/watchnext/.env"]
  - [chown, ubuntu:ubuntu, /opt/watchnext/.env]
  - [chmod, '600', /opt/watchnext/.env]
  - [sh, -c, "cd /opt/watchnext && docker compose -p watchnext-production -f docker-compose.yaml -f deploy/oracle/docker-compose.yaml up -d --build"]
