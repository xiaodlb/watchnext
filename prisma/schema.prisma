// Issue #48 — Prisma mapping of the native WatchNext SQLite schema (db/migrations 0001-0005).
// Native SQL stays the only SQLite DDL authority: never run `migrate dev`, `migrate reset`,
// `db push` or `db execute` against this schema. See _docs/prisma-baseline.md.
//
// Mapping rules (prisma-baseline §4):
// - PascalCase models with @@map, camelCase fields with @map; every table and column is mapped.
// - Every relation is NoAction/NoAction; composite foreign keys keep their exact column lists.
// - Inline UNIQUE constraints keep their `sqlite_autoindex_*` names; explicit indexes keep theirs.
// - 0/1 flags and every INTEGER column stay Int (STRICT tables cannot hold BOOLEAN; BigInt would rebuild).
// - The nine strftime defaults use dbgenerated so a create without createdAt stores a real ISO value.
// - CHECKs, STRICT typing, the 18 triggers and the mood seed rows exist only in the native SQL and in
//   prisma/migrations/0_native_0005_baseline/migration.sql.

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "esm"
}

datasource db {
  provider = "sqlite"
}

/// Native migration ledger. Read-only for Prisma code; only db/migrate.ts writes it.
model NativeMigration {
  version   String @id
  filename  String
  checksum  String
  appliedAt String @default(dbgenerated("(strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))")) @map("applied_at")

  @@map("schema_migrations")
}

model Group {
  id               String  @id
  name             String
  createdAt        String  @default(dbgenerated("(strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))")) @map("created_at")
  accessMode       String  @default("legacy") @map("access_mode")
  ownerAccountId   String? @map("owner_account_id")
  inviteGeneration Int     @default(1) @map("invite_generation")

  owner              Account?            @relation(fields: [ownerAccountId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  invitations        Invitation[]
  members            Member[]
  titles             Title[]
  legacySessions     LegacySession[]
  metadataReviews    MetadataReview[]
  accountSessions    AccountSession[]
  accountMemberships AccountMembership[]

  @@unique([id, accessMode], map: "groups_id_mode")
  @@map("groups")
}

model Invitation {
  id         String  @id
  groupId    String  @map("group_id")
  tokenHash  String  @unique(map: "sqlite_autoindex_invitations_2") @map("token_hash")
  revokedAt  String? @map("revoked_at")
  createdAt  String  @default(dbgenerated("(strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))")) @map("created_at")
  generation Int     @default(1)

  group              Group                    @relation(fields: [groupId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  legacySessions     LegacySession[]
  pendingInvitations PendingGroupInvitation[]

  @@unique([id, groupId], map: "invitations_id_group")
  @@map("invitations")
}

model Member {
  id          String @id
  groupId     String @map("group_id")
  name        String
  nameKey     String @map("name_key")
  avatarColor String @map("avatar_color")
  createdAt   String @default(dbgenerated("(strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))")) @map("created_at")

  group              Group               @relation(fields: [groupId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// A list on purpose: native UNIQUE(member_id) already allows at most one membership (prisma-baseline §4 rule 1).
  accountMemberships AccountMembership[]
  contributions      Contributor[]
  progress           Progress[]
  ratings            Rating[]
  notes              Note[]
  legacySessions     LegacySession[]
  metadataReviews    MetadataReview[]

  @@unique([groupId, nameKey], map: "sqlite_autoindex_members_2")
  @@unique([id, groupId], map: "sqlite_autoindex_members_3")
  @@map("members")
}

model Title {
  id                  String  @id
  groupId             String  @map("group_id")
  title               String?
  titleKey            String? @map("title_key")
  contentType         String? @map("content_type")
  durationSeconds     Int?    @map("duration_seconds")
  numberingStyle      String  @map("numbering_style")
  providerNamespace   String? @map("provider_namespace")
  providerId          String? @map("provider_id")
  sourceUrl           String? @map("source_url")
  watchUrl            String? @map("watch_url")
  coverUrl            String? @map("cover_url")
  metadataUnavailable Int     @default(0) @map("metadata_unavailable")
  archived            Int     @default(0)
  createdAt           String  @default(dbgenerated("(strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))")) @map("created_at")

  group          Group           @relation(fields: [groupId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  genres         TitleGenre[]
  moods          TitleMood[]
  contributors   Contributor[]
  progress       Progress[]
  ratings        Rating[]
  notes          Note[]
  metadataFields MetadataField[]

  @@unique([groupId, contentType, titleKey], map: "sqlite_autoindex_titles_2")
  @@unique([groupId, providerNamespace, providerId], map: "sqlite_autoindex_titles_3")
  @@unique([id, groupId], map: "sqlite_autoindex_titles_4")
  @@unique([id, groupId, numberingStyle], map: "sqlite_autoindex_titles_5")
  @@index([groupId, archived], map: "titles_active")
  @@map("titles")
}

model TitleGenre {
  titleId  String @map("title_id")
  genreKey String @map("genre_key")
  label    String

  title Title @relation(fields: [titleId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([titleId, genreKey])
  @@map("title_genres")
}

model Mood {
  code  String @id
  label String @unique(map: "sqlite_autoindex_moods_2")

  titles TitleMood[]

  @@map("moods")
}

model TitleMood {
  titleId  String @map("title_id")
  moodCode String @map("mood_code")

  title Title @relation(fields: [titleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  mood  Mood  @relation(fields: [moodCode], references: [code], onDelete: NoAction, onUpdate: NoAction)

  @@id([titleId, moodCode])
  @@map("title_moods")
}

model Contributor {
  groupId   String @map("group_id")
  titleId   String @map("title_id")
  memberId  String @map("member_id")
  createdAt String @default(dbgenerated("(strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))")) @map("created_at")

  title  Title  @relation(fields: [titleId, groupId], references: [id, groupId], onDelete: NoAction, onUpdate: NoAction)
  member Member @relation(fields: [memberId, groupId], references: [id, groupId], onDelete: NoAction, onUpdate: NoAction)

  @@id([titleId, memberId])
  @@map("contributors")
}

model Progress {
  groupId          String @map("group_id")
  titleId          String @map("title_id")
  memberId         String @map("member_id")
  numberingStyle   String @map("numbering_style")
  positionState    String @default("unknown") @map("position_state")
  nextSeason       Int?   @map("next_season")
  nextEpisode      Int?   @map("next_episode")
  timestampSeconds Int?   @map("timestamp_seconds")
  completed        Int    @default(0)

  title  Title  @relation(fields: [titleId, groupId, numberingStyle], references: [id, groupId, numberingStyle], onDelete: NoAction, onUpdate: NoAction)
  member Member @relation(fields: [memberId, groupId], references: [id, groupId], onDelete: NoAction, onUpdate: NoAction)

  @@id([titleId, memberId])
  @@map("progress")
}

model Rating {
  groupId  String @map("group_id")
  titleId  String @map("title_id")
  memberId String @map("member_id")
  score    Int

  title  Title  @relation(fields: [titleId, groupId], references: [id, groupId], onDelete: NoAction, onUpdate: NoAction)
  member Member @relation(fields: [memberId, groupId], references: [id, groupId], onDelete: NoAction, onUpdate: NoAction)

  @@id([titleId, memberId])
  @@map("ratings")
}

model Note {
  groupId  String @map("group_id")
  titleId  String @map("title_id")
  memberId String @map("member_id")
  body     String

  title  Title  @relation(fields: [titleId, groupId], references: [id, groupId], onDelete: NoAction, onUpdate: NoAction)
  member Member @relation(fields: [memberId, groupId], references: [id, groupId], onDelete: NoAction, onUpdate: NoAction)

  @@id([titleId, memberId])
  @@map("notes")
}

/// Legacy trusted-name session (table group_sessions).
model LegacySession {
  tokenHash       String  @id @map("token_hash")
  groupId         String  @map("group_id")
  invitationId    String  @map("invitation_id")
  activeMemberId  String? @map("active_member_id")
  createdAt       String  @default(dbgenerated("(strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))")) @map("created_at")
  contextRevision Int     @default(0) @map("context_revision")

  group        Group      @relation(fields: [groupId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  invitation   Invitation @relation(fields: [invitationId, groupId], references: [id, groupId], onDelete: NoAction, onUpdate: NoAction)
  activeMember Member?    @relation(fields: [activeMemberId, groupId], references: [id, groupId], onDelete: NoAction, onUpdate: NoAction)

  @@map("group_sessions")
}

model MetadataField {
  titleId     String  @map("title_id")
  field       String
  origin      String
  cleared     Int     @default(0)
  retrievedAt String? @map("retrieved_at")
  expiresAt   String? @map("expires_at")

  title Title @relation(fields: [titleId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([titleId, field])
  @@index([origin, expiresAt], map: "metadata_expiry")
  @@map("metadata_fields")
}

/// session_id deliberately has no foreign key: it holds either kind of session hash.
model MetadataReview {
  handleHash String @id @map("handle_hash")
  groupId    String @map("group_id")
  memberId   String @map("member_id")
  sessionId  String @map("session_id")
  expiresAt  String @map("expires_at")
  payload    String

  group  Group  @relation(fields: [groupId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  member Member @relation(fields: [memberId, groupId], references: [id, groupId], onDelete: NoAction, onUpdate: NoAction)

  @@index([expiresAt], map: "metadata_review_expiry")
  @@map("metadata_reviews")
}

model Account {
  id                String @id
  username          String
  usernameKey       String @unique(map: "sqlite_autoindex_accounts_2") @map("username_key")
  passwordVersion   Int    @map("password_version")
  passwordAlgorithm String @map("password_algorithm")
  passwordHash      String @map("password_hash")
  passwordSalt      String @map("password_salt")
  passwordN         Int    @map("password_n")
  passwordR         Int    @map("password_r")
  passwordP         Int    @map("password_p")
  passwordMaxmem    Int    @map("password_maxmem")
  recoveryDigest    String @map("recovery_digest")
  createdAt         String @default(dbgenerated("(strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))")) @map("created_at")

  ownedGroups Group[]
  sessions    AccountSession[]
  memberships AccountMembership[]

  @@map("accounts")
}

/// Account session times are integer Unix seconds.
model AccountSession {
  tokenHash       String  @id @map("token_hash")
  accountId       String  @map("account_id")
  createdAt       Int     @map("created_at")
  expiresAt       Int     @map("expires_at")
  revokedAt       Int?    @map("revoked_at")
  selectedGroupId String? @map("selected_group_id")
  contextRevision Int     @default(0) @map("context_revision")

  account       Account @relation(fields: [accountId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  selectedGroup Group?  @relation(fields: [selectedGroupId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([accountId, expiresAt], map: "account_sessions_account")
  @@map("account_sessions")
}

model AccountMembership {
  accountId               String  @map("account_id")
  groupId                 String  @map("group_id")
  groupMode               String  @default("account") @map("group_mode")
  memberId                String  @unique(map: "sqlite_autoindex_account_memberships_1") @map("member_id")
  status                  String  @default("active")
  joinedInviteGeneration  Int     @map("joined_invite_generation")
  removedInviteGeneration Int?    @map("removed_invite_generation")
  removedAt               String? @map("removed_at")
  createdAt               String  @default(dbgenerated("(strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))")) @map("created_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  group   Group   @relation(fields: [groupId, groupMode], references: [id, accessMode], onDelete: NoAction, onUpdate: NoAction)
  member  Member  @relation(fields: [memberId, groupId], references: [id, groupId], onDelete: NoAction, onUpdate: NoAction)

  @@id([accountId, groupId])
  @@index([groupId, status, accountId], map: "account_memberships_live")
  @@map("account_memberships")
}

model PendingGroupInvitation {
  intentHash   String @id @map("intent_hash")
  invitationId String @map("invitation_id")
  expiresAt    Int    @map("expires_at")

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([expiresAt], map: "pending_group_invitations_expiry")
  @@map("pending_group_invitations")
}
